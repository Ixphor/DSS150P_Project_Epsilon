# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cfpb_pipeline
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=change-me

# CFPB API (no key required)
CFPB_API_BASE_URL=https://www.consumerfinance.gov/data-research/consumer-complaints/search/api/v1/
CFPB_BULK_URL=https://files.consumerfinance.gov/ccdb/complaints.csv.zip
CFPB_API_PAGE_SIZE=500
CFPB_API_WINDOW_CAP=9500
CFPB_API_LOOKBACK_DAYS=14
CFPB_BULK_MIN_DATE=

# FDIC API (no key required)
FDIC_API_BASE_URL=https://api.fdic.gov/banks

# Census API
# Sign up at: https://api.census.gov/data/key_signup.html
CENSUS_API_BASE_URL=https://api.census.gov/data
CENSUS_API_KEY=

# Validation
MAX_REJECT_PCT=1.0